BOT_TOKEN=123456789:AAGASD2cxfatkDasDE22dqfawdfawd2WD-UI
BOT_ADMIN_ID=123456789
# Optional, language of the bot messages in chats, default ru
# BOT_GROUP_LANGUAGE=ru

IS_TESTNET=false
MANIFEST_URL=https://raw.githubusercontent.com/nessshon/tontokengate-bot/main/assets/tonconnect-manifest.json
# Optional, DEX for buying jettons: dedust, stonfi or swapcoffee, default swapcoffee
# DEX_NAME=swapcoffee
# Optional, wallets to offer, app_name list from https://config.ton.org/wallets-v2.json, all by default
# WALLETS=telegram,tonkeeper,mytonwallet

# Optional, a Toncenter API key from @toncenter; without it the bot keeps to 1 request per 1.2 seconds
# TONCENTER_KEY=
# Optional, requests per second of your Toncenter plan
# TONCENTER_RPS=
# Optional, minutes between member checks, default 5
# CHECK_INTERVAL=5

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Optional, for an external Redis with authentication (the Redis in compose.yaml has none)
# REDIS_USERNAME=
# REDIS_PASSWORD=
